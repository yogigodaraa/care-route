# Little Help — environment variables. All optional for the demo screens.
# Used by both the Next.js app and the phase3 API (which loads ../.env).

# Google Places API (provider search): https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# Where the Next.js API routes reach the FastAPI service
PHASE3_API_URL=http://localhost:8000

# Vapi voice assistant (public values, shipped to the browser)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# SMS via Mobile Message (https://mobilemessage.com.au)
MOBILE_MESSAGE_API_KEY=
MOBILE_MESSAGE_API_SECRET=
